# Copy this file to `.env` next to it and fill in the key(s) you need.
# The real `.env` is gitignored — never commit your API key.
#
# Provider and model are chosen in config.py (EMBEDDING_PROVIDER / EMBEDDING_MODEL).
# Only the key for the active provider is required.

# Default provider: "gemini" (Google AI Studio / Gemini API key, free tier OK).
# The official google-genai SDK picks this key up automatically when set.
GEMINI_API_KEY=

# Alias also accepted by the Gemini embedder (same key format):
# GOOGLE_API_KEY=

# For EMBEDDING_PROVIDER = "openai" (model e.g. text-embedding-3-large)
# OPENAI_API_KEY=

# For EMBEDDING_PROVIDER = "cohere" (model e.g. embed-multilingual-v3.0)
# COHERE_API_KEY=

# For EMBEDDING_PROVIDER = "voyage" (model e.g. voyage-multilingual-2)
# VOYAGE_API_KEY=

# For EMBEDDING_PROVIDER = "jina" (e.g. jina-embeddings-v5-omni-small,
# multilingual incl. Arabic; raw HTTPS, no SDK needed).
# JINA_API_KEY=

# For EMBEDDING_PROVIDER = "huggingface" — fully local, NO key needed.
# (Optional tuning lives in config.py: HF_EMBEDDING_MODEL, HF_EMBEDDING_DEVICE,
#  HF_EMBEDDING_BATCH_SIZE, HF_EMBEDDING_USE_PROMPTS.)
# HF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
