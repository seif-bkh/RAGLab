# Supported pipeline only. Never commit .env or paste credentials into logs/chat.
# NVIDIA is used only for embeddings. xKiro is used only for Qwen answers.
NVIDIA_API_KEY=
XKIRO_API_KEY=

EMBEDDING_PROVIDER=nvidia
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_DIM=0
NVIDIA_EMBEDDING_BATCH_SIZE=32

# Native cross-lingual retrieval: no separate chat translation calls.
QUERY_TRANSLATION_ENABLED=0
QUERY_VARIANT_STRATEGY=original

ANSWER_PROVIDER=xkiro
ANSWER_MODEL=qwen/qwen3.8-max:free
ANSWER_PROMPT_VERSION=grounded-v1
ANSWER_MAX_TOKENS=4096
ANSWER_CONTEXT_TOKENS=3000
ANSWER_TOP_K=5
ANSWER_NEIGHBOR_RADIUS=0
ANSWER_WORKERS=1

# Embedding request settings. Qwen enforces live free pricing and bounded retries.
NVIDIA_API_TIMEOUT=180
NVIDIA_API_ATTEMPTS=2
NVIDIA_MIN_INTERVAL=1.6
NVIDIA_MAX_RETRY_DELAY=30

CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
# TIKTOKEN_CACHE_DIR=/absolute/local/path/to/tokenizer-cache
