# RAGLab local environment for the hard answer harness.
#
# WHAT TO RUN (from a clone of this repo; each step is also explained in HARD_HARNESS_LOCAL.md):
#
#   cp raglab/.env.example raglab/.env    # then paste your three keys into it
#   ./raglab/local.sh setup               # venv + requirements-harness.txt
#   ./raglab/local.sh check               # doctor: spends nothing, exits non-zero if a key is short
#   ./raglab/local.sh restore             # pull the frozen dataset + answers + grades from CI
#   ./raglab/local.sh report              # prints the 0.780 table from those rows, no API traffic
#   ./raglab/local.sh judge               # embeddings only: retrieval quality, both arms
#
# Copy this file to raglab/.env (that exact path - config.py loads raglab/.env, and .gitignore keeps
# only the literal name `.env`, so this template is safe to commit). Never commit the filled copy.
# Nothing in this repo prints a key: values are masked to the first 8 characters, the gateway's own
# rule. Placeholders below show the shape only - replace the whole value, keep the name.
#
# Tip: `python app.py` (the console) asks interactively whether to keep, change or add each
# provider's key and writes the answer here for you - no manual editing needed.

### Optional - the HTTP service (raglab/service.py) ---------------------------

# Shared-secret for the REST API. When set, EVERY request must carry it in the
# X-Service-Token header (constant-time compare; CORS preflights are exempt;
# anything without it gets 401 unauthorized). Unset = open (local/dev default).
# RAGLAB_TOKEN is an accepted alias if your deployment already uses that name.
#RAGLAB_SERVICE_TOKEN=paste-a-long-random-string

# Understanding & sufficiency layers. Owner-activated 2026-10-02: the first
# two default ON (evidence state on every /answer + honest refusal before any
# model call when the evidence is absent); "0" restores the pre-activation
# response exactly. Per-micro retrieval stays OFF (rejected by live A/B).
#SUFFICIENCY_FIELDS_ENABLED=1
#ANSWER_SUFFICIENCY_COMMITMENT=1
#PER_MICRO_RETRIEVAL_ENABLED=0
# Phase 8 (owner-activated 2026-10-02, default ON): re-express an
# insufficient practical question as the nearest technical question the
# corpus covers (ONE bounded model call; full disclosure; fail-closed).
# "0" restores the plain refusal exactly.
#REPHRASE_INTERROGATION_ENABLED=1
# Declared Latin<->Arabic term bridges for evidence anchoring (2026-10-02):
# lets 'what is murabaha?' anchor to المرابحة chunks. 0 = exact-lexical only.
#CROSS_SCRIPT_BRIDGES_ENABLED=1
# Phase 9 (2026-10-05, owner-approved bridge+shape arm — default OFF, not
# activated): the answer probe found TM03 (fr) / TM04 (en) retrieving the
# right guide sections and still refusing, because an Arabic-only corpus gives
# a Latin-script question ZERO shared terms, so no chunk can anchor and every
# requirement stays uncovered. These two gates extend ONLY the declared
# review data, never the decision rules:
#   1) field-vocabulary bridges (documentary credit <-> الاعتماد المستندي،
#      opération de change <-> عمليات الصرف) incl. phrase keys and Latin
#      accent folding;
#   2) the equative definition/purpose shapes («هو تعهد مكتوب…»، «ويستعمل…»)
#      the internal guide actually uses — measured at 1 and 3 chunks out of
#      339, so they cannot make the definitional requirement vacuous.
# Measured: TM03 كافٍ end-to-end on the offline arm, TM04 كافٍ once its
# evidence chunk is in the pool, and the two frozen sets are byte-identical
# (0 false sufficiency / 0 false refusal). Set both to 1 to enable.
# See raglab/audits/PHASE9_STRUCTURE/13_CROSS_SCRIPT_COVERAGE.md.
#   3) the guided search round: a Latin-script question's own terms all have
#      df=0 in an Arabic corpus, so the round used to select nothing and break
#      at once (guided_rounds=[] on both cases). It now searches the declared
#      Arabic equivalents instead — measured to turn TM04 from غير كافٍ to كافٍ
#      on the offline arm even with its evidence at BM25 ranks 27/29/36.
# All three default ON (activated 2026-10-05 after the live 2/2-vs-2/2
# measurement on the owner's index, and an 8-arm offline matrix in which both
# frozen sets stayed byte-identical). Set any of them to 0 to restore the
# pre-fix behavior exactly.
#SUFFICIENCY_FIELD_BRIDGES_ENABLED=1
#SUFFICIENCY_DEFINITION_SHAPE_ENABLED=1
#SUFFICIENCY_GUIDED_BRIDGED_ENABLED=1



### Required #1 - the answer model -----------------------------------------

# xKiro gateway key. Answering is qwen/qwen3.8-max:free through this gateway and nothing else; the
# harness refuses other SKUs rather than substituting one. Base URL is fixed in code
# (https://api.xkiro.com/v1), so only the key belongs here.
XKIRO_API_KEY=paste-your-xkiro-key-here

### Required #2 - the judge -------------------------------------------------

# Experiential Labs gateway key, value starts with xpl_ (dashboard -> API Keys). This is NOT a free
# tier: routed tokens are billed per token against your account credits, and the plan has to say
# grader_llm.credits_acknowledged=true or the harness stops. ~46 requests for 300 comparisons.
EXPERIENTIAL_API_KEY=xpl_paste-your-key-here

### Required #3 - embeddings ------------------------------------------------

# NVIDIA build endpoint key, value starts with nvapi-. Used by nvidia/nemotron-3-embed-1b (2048
# dims) for retrieval and for the no-LLM retrieval judge. No fallback model exists.
NVIDIA_API_KEY=nvapi-paste-your-key-here


### Optional ---------------------------------------------------------------

# A second xKiro key. CI uses it for the authoring role; locally you only need it if you run the
# author phase too.
#XKIRO_API_KEY_JINKO=

# Kira AI gateway (https://kiraai.vn) — optional, used only by `python app.py` for
# OpenAI-compatible chat models such as glm-5.3-free. The console asks for it when
# you select the provider; it can also be set here.
#KIRA_API_KEY=

# Reference-side authoring/auditing (the plan's `llm` role). Not used by grading or answering.
#GOOGLE_API_KEY=
#GEMINI_API_KEY=

# Point the judging adapter at another deployment of the same gateway. Only an OpenAI-compatible
# Experiential Labs base URL is accepted; nothing here may redirect to a different vendor.
#EXPERIENTIAL_BASE_URL=https://api.experientiallabs.ai/v1

# Which named credential the harness should read, with its value in HARNESS_API_KEY. This is how CI
# injects one secret without naming it in the workflow; you normally set the three keys above.
#HARNESS_CREDENTIAL_ALIAS=XKIRO_API_KEY
#HARNESS_API_KEY=

# Chunking is pinned in raglab/benchmarks/hard_harness_plan.json (currently 640/40), NOT here, so a
# stray shell value cannot silently change the frozen dataset version. CHUNK_SIZE_TOKENS here only
# affects the main application, which still defaults to 220.
#CHUNK_SIZE_TOKENS=640
#CHUNK_OVERLAP_TOKENS=40

# Retrieval judge: 100 families per language by default (300 questions). 0 judges every accepted
# family. Full pool and sampled numbers are different measurements and are not comparable.
#HARD_HARNESS_JUDGE_LIMIT_PER_LANGUAGE=100

# Where tiktoken keeps cl100k_base. Without it the chunker falls back to a chars/4 estimator, chunk
# boundaries move, and your recall numbers stop meaning the same thing as CI's. `check` warns loudly.
#TIKTOKEN_CACHE_DIR=../.cache/hard_harness/tokenizer

# Where embeddings are cached, so a re-run costs no calls. The file is resumable; delete it only to
# rebuild the index from scratch.
#NVIDIA_EMBEDDING_CACHE_FILE=../.cache/hard_harness/embeddings_cache_nvidia.json

# Per-job soft deadline in minutes (CI uses 105 for grading).
#HARNESS_DEADLINE_MINUTES=105


### Deliberately absent ----------------------------------------------------

# EMBEDDING_MODEL, ANSWER_MODEL and the translation knobs are not here on purpose: config.py rejects
# stale .env values for them instead of using them. Model selection lives in code and in the plan
# file, so a local override can never quietly change what a published number means.
