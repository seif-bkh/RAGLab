# Copy this file to `.env` next to it and fill in the key(s) you need.
# The real `.env` is gitignored — never commit your API key.
#
# Provider and model are chosen in config.py (EMBEDDING_PROVIDER / EMBEDDING_MODEL).
# Only the key for the active provider is required.

# For EMBEDDING_PROVIDER = "openai" (default; model text-embedding-3-large)
OPENAI_API_KEY=

# For EMBEDDING_PROVIDER = "cohere" (model e.g. embed-multilingual-v3.0)
COHERE_API_KEY=

# For EMBEDDING_PROVIDER = "voyage" (model e.g. voyage-multilingual-2)
VOYAGE_API_KEY=
