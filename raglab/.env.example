# Local credentials. NEVER commit .env or put key values in logs/chat.
NVIDIA_API_KEY=

# Exact requested embedding space. Re-ingest --reset after changing spaces.
EMBEDDING_PROVIDER=nvidia
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_DIM=0
NVIDIA_EMBEDDING_BATCH_SIZE=32

# Exact model IDs only; no automatic fallback/substitution.
# Other candidates: deepseek-ai/deepseek-v4-pro-0813, nvidia/riva-translate-4b-instruct-v2
QUERY_TRANSLATION_PROVIDER=nvidia
NVIDIA_TRANSLATION_MODEL=moonshotai/kimi-k3
NVIDIA_TRANSLATION_FALLBACK_MODELS=
QUERY_TRANSLATION_PROMPT=banking-v2
QUERY_TRANSLATION_ENABLED=1
QUERY_TRANSLATION_STRICT=0
QUERY_VARIANT_STRATEGY=best

# Bounded requests/pacing. Do not interpret trial endpoint latency as an SLA.
NVIDIA_API_TIMEOUT=120
NVIDIA_API_ATTEMPTS=2
NVIDIA_MIN_INTERVAL=1.6
NVIDIA_MAX_RETRY_DELAY=30
NVIDIA_CHAT_STREAM=1

# Optional answer generation: invoked only by answer / benchmark --stage all.
ANSWER_MODEL=moonshotai/kimi-k3
ANSWER_PROMPT_VERSION=grounded-v1
ANSWER_MAX_TOKENS=4096
ANSWER_CONTEXT_TOKENS=3000
ANSWER_TOP_K=5
ANSWER_NEIGHBOR_RADIUS=0
ANSWER_WORKERS=2

# Chunk parameters; --reset after changes.
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40

# Optional legacy providers (explicitly select in EMBEDDING_PROVIDER).
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# JINA_API_KEY=
# HF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# TIKTOKEN_CACHE_DIR=/absolute/local/path/to/tokenizer-cache
